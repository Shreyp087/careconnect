{
  "name": "careconnect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server:dev": "nodemon src/server.js",
    "client:dev": "vite --config client/vite.config.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node src/server.js",
    "sendgrid:test": "node scripts/sendgrid-test.cjs",
    "migrate": "node scripts/migrate.cjs"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
